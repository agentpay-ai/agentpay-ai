PORT=3001

# ─── Network ──────────────────────────────────────────────────────────────────
# "testnet" or "mainnet". Any other value exits non-zero at startup.
# Only the active network's payment scheme is registered, so a testnet server
# cannot settle mainnet payloads and vice versa.
#
#   testnet → BotChain Testnet, chain 968 (eip155:968)
#             USDT 0x75edC9335175Fc0552D51D48439F229c10420fe3
#   mainnet → BotChain Mainnet, chain 677 (eip155:677)
#             USDT 0xaBabc7Ddc03e501d190C676BF3d92ef0e6e87a3C
X402_NETWORK=testnet

# Optional comma-separated extra CAIP-2 networks to also accept (e.g. Celo).
# Leave unset unless you specifically need them.
# X402_EXTRA_NETWORKS=eip155:42220,eip155:11142220

# ─── AI provider ──────────────────────────────────────────────────────────────
# Keys beginning with "sk-ant-" are treated as direct Anthropic Console keys.
# Anything else is routed to the AgentRouter gateway (https://agentrouter.org).
# If the request fails with 403 "该令牌无权访问模型", the token lacks permission
# for ANTHROPIC_MODEL — enable it at https://agentrouter.org/console/token.
ANTHROPIC_API_KEY=your_anthropic_or_agentrouter_key_here

# Model id. Must be one your token is permitted to call.
ANTHROPIC_MODEL=claude-opus-5

# Override the gateway base URL. Leave unset to use the prefix-based default above.
# ANTHROPIC_BASE_URL=https://agentrouter.org

# AgentRouter gates on client identity; override only if the gateway requires it.
# ANTHROPIC_USER_AGENT=Cline/3.0.0

# ─── Payments ─────────────────────────────────────────────────────────────────
X402_API_KEY=demo
# Deployed AgentPayRegistry UUPS ERC1967 Proxy Vault Contract (BotChain Testnet)
PAYMENT_RECIPIENT_ADDRESS=0xc1eBB154EFf9bf9c08e39978E1447cC05e726dC6

# HMAC secret for prepaid session tokens (after a USDT budget deposit).
# Change this in production. Falls back to a dev default if unset.
# SESSION_SECRET=replace-with-long-random-string

# Optional BotChain RPC override (defaults to bohr.life / botchain.ai by network)
# BOTCHAIN_RPC_URL=https://rpc.bohr.life
